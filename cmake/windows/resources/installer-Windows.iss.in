; Deck Out Windows installer (Inno Setup)
; Generated by CMake - do not edit the .generated.iss file directly.

#define MyProjectName "@CMAKE_PROJECT_NAME@"
#define MyAppName "@PLUGIN_DISPLAY_NAME@"
#define MyAppVersion "@CMAKE_PROJECT_VERSION@"
#define MyAppPublisher "@PLUGIN_AUTHOR@"
#define MyAppURL "@PLUGIN_WEBSITE@"
#define MyAppId "@WINDOWS_APP_UUID@"

[Setup]
; Unique AppId - do not reuse for other applications.
AppId={{{#MyAppId}}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; OBS only loads Windows plugins from ProgramData (not %APPDATA%).
DefaultDirName={commonappdata}\obs-studio\plugins\{#MyProjectName}
UsePreviousAppDir=no
DisableDirPage=yes
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputBaseFilename={#MyProjectName}-{#MyAppVersion}-windows-x64-Installer
Compression=lzma
SolidCompression=yes
WizardStyle=modern
DirExistsWarning=no
RestartIfNeededByRun=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin
CloseApplications=force
SetupLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\release\Package\{#MyProjectName}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{cm:ProgramOnTheWeb,{#MyAppName}}"; Filename: "{#MyAppURL}"

[Code]
function GetOBSDirName(Value: String): String;
var
  InstallPath: String;
begin
  Result := ExpandConstant('{autopf}\obs-studio');
  if RegQueryStringValue(HKLM32, 'SOFTWARE\OBS Studio', '', InstallPath) then
    Result := InstallPath;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    { Remove leftover Program Files installs from early manual copies. }
    if DelTree(ExpandConstant('{code:GetOBSDirName}\data\obs-plugins\{#MyProjectName}'), True, True, True) then
      Log('Removed legacy Program Files data folder for {#MyProjectName}');
    if DeleteFile(ExpandConstant('{code:GetOBSDirName}\obs-plugins\64bit\{#MyProjectName}.dll')) then
      Log('Removed legacy Program Files DLL');
    if DeleteFile(ExpandConstant('{code:GetOBSDirName}\obs-plugins\64bit\{#MyProjectName}.pdb')) then
      Log('Removed legacy Program Files PDB');

    { Remove mistaken per-user AppData installs (OBS does not load from there). }
    if DelTree(ExpandConstant('{userappdata}\obs-studio\plugins\{#MyProjectName}'), True, True, True) then
      Log('Removed unused AppData plugin folder for {#MyProjectName}');
  end;
end;
